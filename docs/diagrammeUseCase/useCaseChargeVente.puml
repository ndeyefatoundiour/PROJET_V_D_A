@startuml UseCase_Admin
left to right direction

actor "charger de vente" as CV

rectangle "StoreManager Pro" {

' VENTES

    usecase "Ventes (POS)" as UCP2
        usecase "Afficher statistiques vente" as UC4

        usecase "Valider une vente" as UC5
            usecase "Ajouter des articles" as UC51
                usecase "Choisir articles" as UC511
            usecase "Choisir client" as UC52
            usecase "Choisir règlement" as UC53

        usecase "Consulter le registre des ventes" as UC6
            usecase "Ligne de vente" as UC61
                usecase "Afficher article" as UC611


    ' GESTION DES DETTES

    usecase "Gestion des dettes" as UCP3

        usecase "statistique dette" as UC7

        usecase "Registre de dette active" as UC8
            usecase "Filtre par clients" as UC81
            usecase "Lister les articles de la dette" as UC82
                usecase "articles" as UC821
                    usecase "lister articles" as UC8211
                usecase "Paiements" as UC822
                    usecase "lister paiement" as UC8221
                usecase "Remboursement" as UC823
                    usecase "lister enregistrement remboursement" as UC8231
                        usecase "enregistre remboursement" as UC822311
                            usecase "choisir canal paiement" as UC823111


     usecase "Déconnexion" as UCP6
}


' VENTES

CV --> UCP2

UCP2 ..> UC4 : <<include>>
UCP2 ..> UC5 : <<include>>
UCP2 ..> UC6 : <<include>>

UC5 ..> UC51 : <<include>>
UC5 ..> UC52 : <<include>>
UC5 ..> UC53 : <<include>>

UC51 ..> UC511 : <<include>>

UC6 <.. UC61 : <<extend>>
UC61 ..> UC611 : <<include>>



' GESTION DES DETTES
CV --> UCP3

UCP3 ..> UC7 : <<include>>
UCP3 ..> UC8 : <<include>>
UC8 <.. UC81 : <<extend>>
UC8 ..> UC82: <<include>>
UC82 <.. UC821 : <<extend>>
UC82 <.. UC822 : <<extend>>
UC82 <.. UC823 : <<extend>>
UC821 <.. UC8211 : <<extend>>
UC8211 ..> UC82111: <<include>>
UC822 <.. UC8221 : <<extend>>
UC823 ..> UC8231: <<include>>
UC8231 <.. UC822311 : <<extend>>
UC822311 ..> UC823111: <<include>>

CV --> UCP6

@enduml