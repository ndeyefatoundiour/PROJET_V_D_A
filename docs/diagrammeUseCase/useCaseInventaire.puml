@startuml UseCase_Admin
left to right direction

actor "inventaire" as IV

rectangle "StoreManager Pro" {

                    

    ' PRODUITS ET TIERS

    usecase "Catalogue et tiers" as UCP5

        usecase "afficher statistique" as UC11
        usecase "gestion" as UC12

            usecase "Gérer les produits" as UC121
                usecase "Ajouter un produit" as UC1211
                usecase "lister catalogue" as UC1212
          

            usecase "Gérer les clients" as UC122
                usecase "Ajouter un client" as UC1221
                usecase "lister repertoir client" as UC1222
         

            usecase "Gérer les fournisseurs" as UC123
                usecase "Ajouter un fournisseur" as UC1231
                usecase "repertoir fournisseur" as UC1232
         


    ' DECONNEXION

    usecase "Déconnexion" as UCP6
}


IV --> UCP5
IV --> UCP6




' PRODUIT ET TIERS


UCP5 ..> UC11 : <<include>>
UCP5 ..> UC12 : <<include>>
UC12 <-- UC121
UC121 <.. UC1211 : <<extend>>
UC121 <.. UC1212 : <<extend>>
UC12 <-- UC122
UC122 <.. UC1221 : <<extend>>
UC122 <.. UC1222 : <<extend>>
UC12 <-- UC123
UC123 <.. UC1231 : <<extend>>
UC123 <.. UC1232 : <<extend>>



@enduml